# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# ---------------------------------------------------------------------------
# Option 1 — DATABASE_URL (local development)
# ---------------------------------------------------------------------------
# A complete connection URL. Use the postgresql+psycopg:// scheme so SQLAlchemy
# selects psycopg 3.
#
#   local Postgres:
#     postgresql+psycopg://postgres@localhost:5432/portfolio
#
#   RDS reached directly (only if the instance is publicly accessible):
#     postgresql+psycopg://USER:PASSWORD@mydb.abc123.us-east-1.rds.amazonaws.com:5432/portfolio?sslmode=require
#
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/portfolio

# ---------------------------------------------------------------------------
# Option 2 — Secrets Manager (the deployed EC2 instance)
# ---------------------------------------------------------------------------
# Preferred in production, and what the assignment's "no credentials" rule is
# really after. RDS generates the master password and stores it in Secrets
# Manager (--manage-master-user-password); the EC2 instance role grants read
# access to that one secret. No password is ever typed, filed, or committed.
#
# Set these INSTEAD of DATABASE_URL. If DATABASE_URL is also set it wins, so
# leave it unset on the instance.
#
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:rds!db-xxxx
# DB_HOST=fixed-income-db.abc123.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=portfolio

# TLS mode. 'require' encrypts the connection but does not verify the server's
# identity. 'verify-full' also authenticates the server and prevents an
# impersonation attack, but needs the RDS CA bundle on disk:
#
#   curl -o rds-ca-global.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
#
# then append &sslrootcert=/path/to/rds-ca-global.pem to the URL. The bundle is
# gitignored. 'require' is acceptable here because the database is not publicly
# accessible and traffic never leaves the VPC.
# DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Connection pool
# ---------------------------------------------------------------------------
# RDS derives max_connections from instance memory; db.t4g.micro allows roughly
# 112, so the SQLAlchemy defaults below are comfortable. Lower them if you run
# several processes against one instance.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Where the loader reads CSVs from. Used only by the load CLI — the web app reads
# exclusively from the database at runtime, per assignment requirement 1.
DATA_DIR=data

# Dash server binding. 0.0.0.0 on EC2 so the security group can expose the port;
# 127.0.0.1 locally so a dev server is not exposed to the network.
HOST=127.0.0.1
PORT=8050
DEBUG=false
