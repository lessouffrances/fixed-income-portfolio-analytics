# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Aiven for PostgreSQL exposes a "Service URI" on the service overview page:
#   postgres://avnadmin:PASSWORD@pg-xxxx.a.aivencloud.com:12345/defaultdb?sslmode=require
#
# Two things differ from a stock local Postgres and both bite if missed:
#   - the port is NOT 5432
#   - sslmode=require is mandatory; Aiven refuses plaintext connections
#
# Use the postgresql+psycopg:// scheme so SQLAlchemy selects psycopg 3.
DATABASE_URL=postgresql+psycopg://user:password@host:port/dbname?sslmode=require

# Aiven's free plan caps concurrent connections (~20), shared across the loader,
# the web app and any psql session. Keep the pool small or the app will fail to
# connect for reasons that look unrelated.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Where the loader reads CSVs from. Used only by the load CLI — the web app reads
# exclusively from the database at runtime, per assignment requirement 1.
DATA_DIR=data

# Dash server binding. 0.0.0.0 so the EC2 security group can expose the port.
HOST=0.0.0.0
PORT=8050
DEBUG=false
